# Local learning database. Protect it because it stores raw DVIR notes.
DVIR_LEARNING_DB=data/dvir_learning.sqlite3
DVIR_MODEL_CANDIDATES_DIR=models/dvir_candidates
DVIR_ACTIVE_MODEL=models/dvir_active/dvir_text_model.joblib

# Collect normally for 72 hours before training is considered.
DVIR_COLLECTION_DAYS=3

# Train only with a sizable, human-reviewed dataset. Adjust after data audit.
DVIR_MIN_REVIEWED_SAMPLES=300
DVIR_MIN_SAMPLES_PER_CLASS=5
DVIR_RETRAIN_NEW_SAMPLES=100
DVIR_TRAINER_POLL_SECONDS=300
DVIR_MIN_MACRO_F1=0.60
