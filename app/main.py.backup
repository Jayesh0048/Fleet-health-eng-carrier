from __future__ import annotations

import os
from contextlib import asynccontextmanager

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from sqlalchemy import text
from sqlalchemy.exc import SQLAlchemyError

from app import models  # noqa: F401 - registers SQLAlchemy metadata
from app.database import Base, engine
from app.routes import fleet_health, ingestion, maintenance

APP_ENV = os.getenv("APP_ENV", "production").strip().lower()


@asynccontextmanager
async def lifespan(app: FastAPI):
    # Development convenience only. create_all() does not migrate existing tables.
    if APP_ENV == "development":
        Base.metadata.create_all(bind=engine)
    yield


app = FastAPI(
    title="Fleet Health & Maintenance Agent (Reference MVP)",
    version="0.2.0",
    description=(
        "Rule-based vehicle-health triage, idempotent reference ingestion, and auditable "
        "work-order workflow. Priority scores are not calibrated failure probabilities. "
        "This standalone reference is not production-secure until TMS authentication, "
        "authorization, migrations, and source integrations are implemented."
    ),
    docs_url="/docs" if APP_ENV in {"development", "test"} else None,
    redoc_url="/redoc" if APP_ENV in {"development", "test"} else None,
    lifespan=lifespan,
)

_origins = [
    origin.strip()
    for origin in os.getenv("CORS_ALLOWED_ORIGINS", "").split(",")
    if origin.strip()
]
if _origins:
    app.add_middleware(
        CORSMiddleware,
        allow_origins=_origins,
        allow_credentials=True,
        allow_methods=["GET", "POST", "PATCH", "OPTIONS"],
        allow_headers=["Authorization", "Content-Type", "X-Tenant-ID", "Idempotency-Key"],
    )

app.include_router(fleet_health.router)
app.include_router(maintenance.router)
app.include_router(ingestion.router)


@app.get("/health", tags=["Operations"])
def health_check():
    """Liveness only: confirms the API process can serve requests."""
    return {"status": "ok", "service": "fleet-health-agent", "version": app.version}


@app.get("/ready", tags=["Operations"])
def readiness_check():
    """Readiness check: confirms the configured database responds to a simple query."""
    try:
        with engine.connect() as connection:
            connection.execute(text("SELECT 1"))
    except SQLAlchemyError as exc:
        raise HTTPException(status_code=503, detail="Database is not ready") from exc
    return {"status": "ready", "database": "ok"}
